---
import { FileWarningIcon, PlusIcon, TriangleAlert } from "lucide-react";
import Link from "./sections/Link.astro";
---

<section class="bg-chart-3/5 p-3 relative">
    <!-- <PlusIcon className="absolute size-4 left-[-9.4px] bottom-[-9.4px]" /> -->
    <!-- <PlusIcon className="absolute size-4 right-[-9.4px] bottom-[-9.4px]" /> -->
    <p class="text-foreground/70 sm:text-sm justify-center text-xs flex sm:flex-row flex-col items-center gap-2">
        <span class="flex items-center gap-2">
            <TriangleAlert className="text-chart-3 size-5" /> Pre-release — this
            is not a stable cdin.
        </span>
        <a
            class="sm:ml-2 underline duration-150 hover:text-primary"
            href="https://github.com/cdin-editor/cdin/issues"
            target="_blank"
        >
            Report any bug or feature to add
        </a>
    </p>
</section>
