---
import {
    Card,
    CardAction,
    CardContent,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
import type { Contributor } from "../types/github";
import backup from "../data/contributors.json";
import Link from "./Link.astro";
import { GitCommit } from "lucide-react";

// ponytail: JSON seed from live API; refresh by hand when roster changes
export const contributors = await (async (): Promise<Contributor[]> => {
    try {
        const res = await fetch(
            "https://api.github.com/repos/cdin-editor/cdin/contributors",
        );
        const data = await res.json();
        return res.ok && Array.isArray(data) && data.length
            ? data
            : (backup as Contributor[]);
    } catch (e) {
        console.error("Failed to fetch contributors:", e);
        return backup as Contributor[];
    }
})();
---

<section class="border-t">
    <div class="grid grid-cols-12 divide-x">
        <div class="col-span-12 md:col-span-4 p-8 space-y-4">
            <p class="text-muted-foreground">
                From bug fixes to new features—your input matters for cdin's
                next release. Whether reporting issues, submitting patches, or
                enhancing guides, you're essential to cdin's journey toward
                becoming the ultimate editor.
            </p>
            <Link
                variant={"outline"}
                href="https://github.com/cdin-editor/cdin"
                icon={GitCommit}
                target="_blank"
                label="CONTRIBUTE TO PROJECT"
            />
        </div>
        <div class="col-span-12 md:col-span-8 grid divide-x lg:grid-cols-12 lg:grid-rows-12">
            {contributors.map((contributor) => (
                <div>hi</div>
            ))}
        </div>
    </div>
</section>
