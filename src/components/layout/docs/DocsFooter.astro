---
const footerLinks = [
  { label: "Back to site", href: "/" },
  { label: "About", href: "/about" },
  { label: "Download", href: "/download" },
  {
    label: "GitHub",
    href: "https://github.com/cdin-editor/cdin",
    external: true,
  },
];
---

<footer class="mt-12 flex flex-col items-center justify-center gap-4 border-t border-border pt-6 text-center text-xs text-muted-foreground">
  <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
    <a
      href="/"
      class="text-primary underline underline-offset-4 transition-[text-decoration-thickness] duration-150 hover:decoration-2"
    >
      <img
        src="/cdin-icons/svg/cdin-outline-transparent.svg"
        alt="cdin home"
        width="1980"
        height="1080"
        class="h-10 w-auto"
      />
    </a>
    <nav aria-label="Docs footer">
      <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
        {footerLinks.map((link, i) => (
          <>
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="text-primary underline underline-offset-4 transition-[text-decoration-thickness] duration-150 hover:decoration-2"
              >
                {link.label}
              </a>
            </li>
            {i < footerLinks.length - 1 && (
              <li aria-hidden="true">
                <span class="block size-1 bg-foreground/10"></span>
              </li>
            )}
          </>
        ))}
      </ul>
    </nav>
  </div>
</footer>
