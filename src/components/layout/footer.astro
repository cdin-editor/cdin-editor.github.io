---
import { copyrightlinks, footerLinks } from "@/data/footer";
---

<footer class="border-t">
  <div class="max-w-7xl mx-auto border-x">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="border-b p-5 sm:border-r sm:p-6 lg:border-b-0 flex flex-col">
        <a href="/" class="w-fit text-xl font-bold tracking-tighter">
          cdin
        </a>
        <p class="mt-4 max-w-xs text-sm leading-6 text-muted-foreground">
          A vim-like, keyboard-driven text editor built on a small C core and
          readable Lua.
        </p>
        <p class="mt-auto pt-4 flex items-center gap-2 text-xs text-muted-foreground">
          <span
            class="size-1.5 bg-yellow-600 animate-pulse"
            aria-hidden="true"
          ></span>
          under development
        </p>
      </div>

      {footerLinks.map((section, index) => (
        <nav
          class:list={[
            "group/card p-5 sm:p-6",
            index === 0 && "border-b lg:border-r lg:border-b-0",
            index === 1 && "border-b sm:border-r sm:border-b-0",
          ]}
          aria-labelledby={`footer-${section.title}`}
        >
          <h2
            id={`footer-${section.title}`}
            class="text-xs text-muted-foreground"
          >
            <span class="text-muted-foreground/60">~/</span>
            {section.title}
          </h2>
          <ul class="mt-4 space-y-2">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="text-sm text-muted-foreground hover:text-foreground transition-opacity duration-150 group-hover/card:opacity-70 group-hover/card:hover:opacity-100"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="border-t border-b px-5 sm:px-6 py-6 flex flex-wrap items-center justify-between gap-4 text-left">
      <p class="text-muted-foreground text-xs">
        © 2026 cdin contributors. Released under the GNU General Public License
        v3.0
      </p>
      <ul class="ml-auto flex items-center gap-4 text-xs">
        {copyrightlinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-muted-foreground hover:text-foreground duration-150"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="md:flex hidden h-20 duration-150 border-x max-w-7xl mx-auto"></div>
</footer>
