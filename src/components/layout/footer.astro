---
import { copyrightlinks } from "@/data/footer";
import { CopyrightIcon } from "lucide-react";
---

<footer class="border-t">
  <div class="max-w-7xl mx-auto border-x pb-8">
    <img
      src="/cdin-icons"
      alt="cdin-portrait"
      width="1980"
      height="1080"
      class="w-50 aspect-square"
    />
    <div class="border-t py-8 px-4 border-b flex flex-wrap items-center justify-between gap-4">
      <p class="text-muted-foreground flex items-center gap-1 text-xs">
        <CopyrightIcon className="  size-3" /> 2026 cdin contributors. Released
        under the GNU General Public License v3.0.
      </p>
      <ul class="flex items-center gap-4 text-xs">
        {copyrightlinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="text-muted-foreground hover:text-foreground duration-150"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
