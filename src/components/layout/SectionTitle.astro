---
interface Props {
    label: string;
    title?: string;
}
const { label, title } = Astro.props;
---

<div class="flex items-center relative justify-between border-b sm:px-6 px-4 gap-8">
    <!-- <Plus className="size-4 absolute left-[-9.4px] bottom-[-9.4px]" /> -->
    <!-- <Plus className="size-4 sm:hidden block absolute right-[-9.4px] bottom-[-9.4px]" /> -->
    <span class="py-6 flex gap-2 items-center text-muted-foreground hover:text-primary duration-150 text-nowrap text-xs">
        {label}
    </span>
    <h1 class="italic absolute sm:block right-0 pr-10 top-10 bg-linear-to-l from-background to-transparent hidden text-6xl md:text-7xl font-bold">
        {title ? title : undefined}
    </h1>
</div>
