---
import type { Contributor } from "@/types/github";
import backup from "@/data/contributors.json";
import Link from "./Link.astro";
import { GitCommit } from "lucide-react";

const fallbackContributors = backup as Contributor[];

const token = import.meta.env.GITHUB_TOKEN;

const contributors = await (async (): Promise<Contributor[]> => {
  try {
    const res = await fetch(
      "https://api.github.com/repos/cdin-editor/cdin/contributors?per_page=100",
      {
        headers: {
          Accept: "application/vnd.github+json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
        signal: AbortSignal.timeout(5000),
      },
    );

    if (!res.ok) {
      console.warn(
        `GitHub contributors API returned ${res.status}; using contributors.json.`,
      );
      return fallbackContributors;
    }

    const data = await res.json();
    return Array.isArray(data) && data.length
      ? (data as Contributor[])
      : fallbackContributors;
  } catch (e) {
    console.warn(
      "GitHub contributors API unavailable; using contributors.json.",
      e,
    );
    return fallbackContributors;
  }
})();

const isBot = (person: Contributor) =>
  person.type === "Bot" || person.login.endsWith("[bot]");

const people = [...contributors]
  .filter((person) => !isBot(person))
  .sort((a, b) => b.contributions - a.contributions);

const previewCount = 4;
const extraCount = Math.max(people.length - previewCount, 0);

const avatarUrl = (url: string) => {
  const src = new URL(url);
  src.searchParams.set("s", "160");
  return src.toString();
};

const totalContributions = people.reduce(
  (total, contributor) => total + contributor.contributions,
  0,
);

const contributorLabel = people.length === 1 ? "contributor" : "contributors";
const commitLabel = totalContributions === 1 ? "commit" : "commits";
const formatCount = (value: number) => value.toLocaleString("en-US");
---

<section class="border-b" aria-labelledby="contributors-heading">
  <h2 id="contributors-heading" class="sr-only">
    Contributors
  </h2>
  <div class="grid grid-cols-12">
    <div class="col-span-12 flex flex-col justify-center gap-6 border-r p-6 md:col-span-4 md:p-8">
      <p class="text-muted-foreground">
        From bug fixes to new features—your input matters for cdin's next
        release. Whether reporting issues, submitting patches, or enhancing
        guides, you're essential to cdin's journey toward becoming the ultimate
        editor.
      </p>
      <div class="-mx-6 border-y md:-mx-8">
        <dl class="divide-y">
          <div class="flex items-center justify-between gap-4 px-6 py-3 md:px-8">
            <dt class="text-[11px] leading-5 text-muted-foreground sm:text-xs">
              {contributorLabel}
            </dt>
            <dd class="text-2xl font-bold tracking-tighter tabular-nums">
              {formatCount(people.length)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4 px-6 py-3 md:px-8">
            <dt class="text-[11px] leading-5 text-muted-foreground sm:text-xs">
              {commitLabel}
            </dt>
            <dd class="text-2xl font-bold tracking-tighter tabular-nums">
              {formatCount(totalContributions)}
            </dd>
          </div>
        </dl>
      </div>
      <Link
        variant={"outline"}
        href="https://github.com/cdin-editor/cdin"
        icon={GitCommit}
        target="_blank"
        label="CONTRIBUTE TO PROJECT"
      />
    </div>
    <div class="col-span-12 flex items-center p-6 md:col-span-8 md:p-8">
      <ul
        id="contributors-grid"
        aria-labelledby="contributors-heading"
        class="grid w-full grid-cols-3 gap-3 sm:grid-cols-5"
      >
        {people.map((person, index) => (
          <li
            class="contributor-tile group relative aspect-square"
            hidden={index >= previewCount}
            data-contributor-extra={index >= previewCount ? "true" : undefined}
          >
            <a
              href={person.html_url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${person.login}, ${person.contributions} contributions`}
              class="block h-full overflow-hidden bg-muted transition-[margin] duration-150 ease-out md:group-hover:mx-2.5 md:group-focus-within:mx-2.5 focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-inset motion-reduce:transition-none"
            >
              <img
                src={avatarUrl(person.avatar_url)}
                alt=""
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover grayscale transition-[filter] duration-200 md:group-hover:grayscale-0 md:group-focus-within:grayscale-0 motion-reduce:transition-none"
              />
            </a>
          </li>
        ))}
        {extraCount > 0 && (
          <li>
            <button
              type="button"
              id="contributors-toggle"
              data-contributors-toggle
              data-contributors-total={people.length}
              aria-expanded="false"
              aria-controls="contributors-grid"
              aria-label={`Show all ${people.length} contributors`}
              class="flex aspect-square w-full flex-col items-center justify-center gap-1 border text-muted-foreground transition-colors duration-150 hover:bg-accent/50 hover:text-foreground focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-inset dark:hover:bg-accent/30"
            >
              <span
                data-contributors-count
                class="text-2xl font-bold tracking-tighter tabular-nums"
              >
                +{extraCount}
              </span>
              <span
                data-contributors-label
                class="text-[10px] font-semibold tracking-widest"
              >
                SHOW ALL
              </span>
            </button>
          </li>
        )}
      </ul>
    </div>
  </div>
</section>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-contributors-toggle]",
  );

  if (toggle) {
    const grid = document.getElementById(
      toggle.getAttribute("aria-controls") ?? "",
    );
    const extras = grid
      ? Array.from(
          grid.querySelectorAll<HTMLElement>("[data-contributor-extra]"),
        )
      : [];
    const count = toggle.querySelector<HTMLElement>(
      "[data-contributors-count]",
    );
    const label = toggle.querySelector<HTMLElement>(
      "[data-contributors-label]",
    );
    const total = Number(toggle.dataset.contributorsTotal ?? extras.length + 4);

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      const next = !expanded;

      toggle.setAttribute("aria-expanded", String(next));
      toggle.setAttribute(
        "aria-label",
        next ? "Show fewer contributors" : `Show all ${total} contributors`,
      );

      for (const extra of extras) {
        extra.hidden = !next;
      }

      if (count) count.textContent = next ? "−" : `+${extras.length}`;
      if (label) label.textContent = next ? "SHOW LESS" : "SHOW ALL";
    });
  }
</script>

<style>
  .contributor-tile::before,
  .contributor-tile::after {
    content: "";
    position: absolute;
    inset-block: -0.5rem;
    width: 0.5625rem;
    border-block: 2px solid var(--foreground);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease-out,
      translate 160ms ease-out;
  }

  .contributor-tile::before {
    left: 0;
    border-left: 2px solid var(--foreground);
    translate: -4px 0;
  }

  .contributor-tile::after {
    right: 0;
    border-right: 2px solid var(--foreground);
    translate: 4px 0;
  }

  @media (min-width: 48rem) {
    .contributor-tile:hover::before,
    .contributor-tile:focus-within::before,
    .contributor-tile:hover::after,
    .contributor-tile:focus-within::after {
      opacity: 1;
      translate: 0 0;
    }
  }

  [data-contributor-extra]:not([hidden]) {
    animation: contributor-reveal 200ms ease-out both;
  }

  @keyframes contributor-reveal {
    from {
      opacity: 0;
      translate: 0 6px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contributor-tile::before,
    .contributor-tile::after {
      transition: none;
      translate: 0 0;
    }

    [data-contributor-extra]:not([hidden]) {
      animation: none;
    }
  }
</style>
