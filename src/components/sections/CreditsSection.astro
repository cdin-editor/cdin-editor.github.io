---
import Philosophy from "./Philosophy.astro";
import Contributors from "./Contributors.astro";
import { PlusIcon } from "lucide-react";
---

<section class="mt-8 relative border-y">
    <!-- <PlusIcon className="absolute size-4 left-[-9.4px] top-[-9.4px]" /> -->
    <!-- <PlusIcon className="absolute size-4 right-[-9.4px] top-[-9.4px]" /> -->
    <!-- <PlusIcon className="absolute size-4 right-[-9.4px] bottom-[-9.4px]" /> -->
    <!-- <PlusIcon className="absolute size-4 left-[-9.4px] bottom-[-9.4px]" /> -->
    <div class="grid grid-cols-4 h-10 border-b">
        {Array(4)
            .fill(null)
            .map(() => (
                <div class="not-last:border-r duration-150 hover:bg-accent/40 dark:hover:bg-accent/30"></div>
            ))}
    </div>
    <Philosophy />
    <div class="grid grid-cols-5 h-10 border-t">
        {Array(5)
            .fill(null)
            .map(() => (
                <div class="not-last:border-r duration-150 hover:bg-accent/40 dark:hover:bg-accent/30"></div>
            ))}
    </div>
    <Contributors />
    <div class="grid border-t grid-cols-4 h-10">
        {Array(4)
            .fill(null)
            .map(() => (
                <div class="not-last:border-r duration-150 hover:bg-accent/40 dark:hover:bg-accent/30"></div>
            ))}
    </div>
</section>
