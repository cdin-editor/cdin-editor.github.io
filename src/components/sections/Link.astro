---
import { Button } from "../ui/button";
import { cn } from "cn";
import type { LucideIcon } from "lucide-react";

interface Props {
    buttonClassName?: string;
    aTagClassName?: string;
    variant:
        | "default"
        | "outline"
        | "secondary"
        | "ghost"
        | "destructive"
        | "link"
        | null
        | undefined;
    target?: string;
    label: string;
    href: string;
    icon?: LucideIcon;
    svg?: HTMLDivElement;
}

const {
    buttonClassName,
    aTagClassName,
    target,
    variant,
    label,
    href,
    icon: Icon,
    svg,
} = Astro.props;
---

<Button
    variant={variant}
    className={cn(
        "p-0 font-semibold text-xs h-auto tracking-widest",
        buttonClassName,
    )}
>
    <a
        target={target}
        href={href}
        class={cn("px-6 py-4 flex items-center gap-2", aTagClassName)}
    >
        {Icon && <Icon size={18} />}
        {svg}
        {label}
    </a>
</Button>
