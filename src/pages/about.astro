---
import {
    Card,
    CardAction,
    CardContent,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/sections/Link.astro";
import { BookOpenText, PlusIcon, ShuffleIcon } from "lucide-react";
import { Button } from "@/components/ui/button";
export const features = [
    "Modal editing built in and on by default. Vim-style Normal / Insert / Visual modes work out of the box.",
    "The codebase is meant to be readable. You should be able to find the edit loop, understand what it does, and change it. Functions are short. Modules are small. There are no clever abstractions that require you to know the whole project before touching any of it.",
    "Features belong in plugins. The core does the minimum that every editor needs. Anything optional is in data/plugins/ where it can be read, copied, modified, or replaced without touching the core. This is how lite-xl approaches things too, and it works.",
    "Startup time and memory use matter. The renderer only redraws what actually changed. Background tasks are coroutines, not threads. An idle cdin draws almost nothing and uses almost no CPU.",
    "Everything is Lua — commands, keybindings, UI behavior, syntax highlighting — all plain Lua loaded from data/ at startup. No recompiling required.",
    "Configurable through data/user/init.lua — plain Lua, no DSL. Change themes, keybindings, or any behavior you can imagine.",
];
export const paragraph =
    "cdin is for people who want a small, fast editor they can actually make their own. If you've used vim, the basics transfer directly. If you're curious how an editor works, the whole thing is readable and modifiable. If you just want a quick, quiet tool to open files and get out of the way, that works too.";
---

<BaseLayout>
    <section class="w-full">
        <div class="grid grid-cols-10 border-b items-center relative">
            <div class="col-span-10 lg:col-span-5 py-10 px-6 border-b lg:border-b-0">
                <span class="font-thin text-xs text-muted-foreground">
                    CHOOSE 0.1%
                </span>
                <h1 class="my-6 lg:text-6xl font-semibold sm:font-bold text-4xl">
                    <span class="text-muted-foreground">C</span> core, <br />{" "}
                    everything else <span class="text-indigo-700">Lua</span>.
                </h1>
                <p class="text-sm text-muted-foreground mb-5">
                    cdin is a small, fast, keyboard-driven text editor with
                    vim-style modal editing on by default. The core is written
                    in C; everything else is Lua you can actually read, change,
                    and recompile-free.
                </p>
                <Link
                    href="/docs"
                    label="Learn more"
                    variant={`default`}
                    aTagClassName="p-4"
                    icon={BookOpenText}
                />
            </div>
            <div class="col-span-10 lg:col-span-5 relative overflow-hidden lg:border-l">
                <img
                    src="/cdin-icons/webp/cdin-glow-transparent-1024.webp"
                    width="1980"
                    height="1080"
                    alt=""
                    class="z-20 animate-pulse"
                />
                <img
                    src="/pattern-light.svg"
                    height="1080"
                    width="1980"
                    alt="bg-pattern"
                    class="absolute top-0 right-0 left-0 w-full h-full -z-10 aspect-square scale-[3] dark:invert"
                />
                <!-- <Button
                    client:visible
                    className="absolute bg-background! hover:bg-foreground! hover:text-primary-foreground border-foreground dark:border-white top-5 right-5"
                    size={"icon-lg"}
                    variant={`outline`}
                >
                    <ShuffleIcon />
                </Button> -->
            </div>
            <!-- <PlusIcon className="absolute size-4 z-30 left-[-9.4px] bottom-[-9.4px]" /> -->
            <!-- <PlusIcon className="absolute size-4 z-30 right-[-9.4px] bottom-[-9.4px]" /> -->
        </div>
        <div class="grid divide-x grid-cols-1 border-b">
            {Array(1)
                .fill(null)
                .map(() => (
                    <div class="h-10 duration-200 dark:hover:bg-accent/30 hover:bg-accent/40"></div>
                ))}
        </div>
        <div class="grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 sm:divide-x divide-y max-lg:[&>*:nth-child(even)]:border-r-0 lg:[&>*:nth-child(3n)]:border-r-0">
            {features.map((feat, i) => (
                <Card className="ring-0 bg-transparent hover:bg-accent/50 dark:hover:bg-accent/20 duration-150 sm:px-5 sm:py-5 min-h-fit sm:min-h-61 last:border-b">
                    <CardHeader className="lg:text-xl opacity-80">
                        0{i + 1}
                    </CardHeader>
                    <CardContent>
                        <p class="text-muted-foreground">{feat}</p>
                    </CardContent>
                </Card>
            ))}
        </div>
        <div class="grid divide-x grid-cols-1 border-b relative">
            {Array(1)
                .fill(null)
                .map(() => (
                    <div class="h-10 duration-200 dark:hover:bg-accent/30 hover:bg-accent/40"></div>
                ))}
            <!-- <PlusIcon className="absolute size-4 left-[-9.4px] bottom-[-9.4px]" /> -->
            <!-- <PlusIcon className="absolute size-4 right-[-9.4px] bottom-[-9.4px]" /> -->
        </div>
        <div class="text-muted-foreground mt-4 sm:p-5 p-3 text-justify wrap-break-word flex">
            <p class="text-wrap text-center justify-center flex flex-wrap gap-2 md:text-sm text-xs">
                {paragraph.split(" ").map((word, i) => (
                    <span class="hover:text-primary cursor-default duration-75">
                        {word}
                    </span>
                ))}
            </p>
        </div>
    </section>
</BaseLayout>
