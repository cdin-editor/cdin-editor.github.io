---
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/sections/Link.astro";
import { BookOpenText } from "lucide-react";
import { features, paragraph } from "@/data/about";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout>
    <section class="w-full">
        <div class="grid grid-cols-10 border-b items-center relative">
            <div class="col-span-10 lg:col-span-5 py-10 px-6 border-b lg:border-b-0">
                <span class="font-thin text-xs text-muted-foreground">
                    CHOOSE 0.1%
                </span>
                <h1 class="my-6 lg:text-6xl font-semibold sm:font-bold text-4xl">
                    <span class="text-muted-foreground">C</span> core, <br />{" "}
                    everything else <span class="text-indigo-700">Lua</span>.
                </h1>
                <p class="text-sm text-muted-foreground mb-5">
                    cdin is a small, fast, keyboard-driven text editor with
                    vim-style modal editing on by default. The core is written
                    in C; everything else is Lua you can actually read, change,
                    and recompile-free.
                </p>
                <Link
                    href={`${basePath}/docs`}
                    label="Learn more"
                    variant={`default`}
                    aTagClassName="p-4"
                    icon={BookOpenText}
                />
            </div>
            <div class="col-span-10 lg:col-span-5 relative overflow-hidden lg:border-l">
                <img
                    src={`${basePath}/cdin-icons/webp/cdin-glow-transparent-1024.webp`}
                    width="1980"
                    height="1080"
                    alt=""
                    class="z-20 animate-pulse"
                />
                <img
                    src={`${basePath}/pattern-light.svg`}
                    height="1080"
                    width="1980"
                    alt="bg-pattern"
                    class="absolute top-0 right-0 left-0 w-full h-full -z-10 aspect-square scale-[3] dark:invert"
                />
                <!-- <Button
                    client:visible
                    className="absolute bg-background! hover:bg-foreground! hover:text-primary-foreground border-foreground dark:border-white top-5 right-5"
                    size={"icon-lg"}
                    variant={`outline`}
                >
                    <ShuffleIcon />
                </Button> -->
            </div>
            <!-- <PlusIcon className="absolute size-4 z-30 left-[-9.4px] bottom-[-9.4px]" /> -->
            <!-- <PlusIcon className="absolute size-4 z-30 right-[-9.4px] bottom-[-9.4px]" /> -->
        </div>
        <div class="grid divide-x grid-cols-1 border-b">
            {Array(1)
                .fill(null)
                .map(() => (
                    <div class="h-10 duration-200 dark:hover:bg-accent/30 hover:bg-accent/40"></div>
                ))}
        </div>
        <div class="grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 sm:divide-x divide-y max-lg:[&>*:nth-child(even)]:border-r-0 lg:[&>*:nth-child(3n)]:border-r-0">
            {features.map((feat, i) => (
                <Card className="ring-0 bg-transparent hover:bg-accent/50 dark:hover:bg-accent/20 duration-150 sm:px-5 sm:py-5 min-h-fit sm:min-h-61 last:border-b">
                    <CardHeader className="lg:text-xl opacity-80">
                        0{i + 1}
                    </CardHeader>
                    <CardContent>
                        <p class="text-muted-foreground">{feat}</p>
                    </CardContent>
                </Card>
            ))}
        </div>
        <div class="grid divide-x grid-cols-1 border-b relative">
            {Array(1)
                .fill(null)
                .map(() => (
                    <div class="h-10 duration-200 dark:hover:bg-accent/30 hover:bg-accent/40"></div>
                ))}
            <!-- <PlusIcon className="absolute size-4 left-[-9.4px] bottom-[-9.4px]" /> -->
            <!-- <PlusIcon className="absolute size-4 right-[-9.4px] bottom-[-9.4px]" /> -->
        </div>
        <div class="text-muted-foreground mt-4 sm:p-5 p-3 text-justify wrap-break-word flex">
            <p class="text-wrap text-center justify-center flex flex-wrap gap-2 md:text-sm text-xs">
                {paragraph.split(" ").map((word) => (
                    <span class="hover:text-primary cursor-default duration-75">
                        {word}
                    </span>
                ))}
            </p>
        </div>
    </section>
</BaseLayout>
