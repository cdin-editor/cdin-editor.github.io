---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/sections/Link.astro";
import {
    CodeXml,
    DownloadIcon,
    Maximize,
    SquareArrowOutUpRight,
    XIcon,
} from "lucide-react";
import { Button } from "@/components/ui/button";
---

<BaseLayout>
    <section class="flex flex-col w-full">
        <div class="px-4 sm:px-6 flex flex-col items-center text-center py-14 sm:py-18">
            <h1 class="lg:text-5xl sm:text-4xl text-3xl font-semibold tracking-tighter flex items-end">
                Download <i class="font-serif font-normal ml-2">Cdin</i>{" "}
                <span class="inline-block w-1.5 h-1.5 sm:h-2 sm:w-2 bg-foreground ml-1.5 relative -top-2 align-end" />
            </h1>
            <p class="text-muted-foreground mt-6">
                Vim muscle memory, none of the weight. right on your desktop.
            </p>
            <div class="flex items-center mt-6 gap-2 flex-wrap">
                <Link
                    href="https://github.com/cdin-editor/cdin/releases/download/v0.2.1-beta.9/cdin-0.2.1-beta.9-windows-setup.exe"
                    svg={
                        <div class="grid grid-cols-2 gap-0.5">
                            {Array(4)
                                .fill(null)
                                .map(() => (
                                    <div class="p-1 bg-accent"></div>
                                ))}
                        </div>
                    }
                    label="DOWNLOAD FOR WINDOWS"
                    variant={`default`}
                />
                <Link
                    icon={CodeXml}
                    label="SEE SOURCE"
                    href="https://github.com/cdin-editor/cdin"
                    variant={`outline`}
                />
            </div>
            <span class="text-muted-foreground mt-4 text-xs font-thin">
                <Button
                    variant="ghost"
                    className="p-0 bg-transparent! px-0 py-0 w-fit h-fit font-semibold text-xs tracking-widest"
                >
                    <span
                        class="flex font-thin items-center gap-2 cursor-default select-none"
                        aria-disabled="true"
                    >
                        FREE
                    </span>
                </Button>{" "}
                -{" "}
                <Link
                    label="OPEN SOURCE"
                    href="https://github.com/cdin-editor/cdin"
                    variant={`ghost`}
                    target="_blank"
                    aTagClassName="p-0 m-0"
                    buttonClassName="p-0 m-0 font-thin bg-transparent!"
                />{" "}
                -{" "}
                <Link
                    label="OTHER PLATFORMS"
                    href="#platforms"
                    variant={`ghost`}
                    aTagClassName="p-0 m-0"
                    buttonClassName="p-0 m-0 font-thin bg-transparent!"
                />
            </span>
        </div>

        <div class="relative">
            <!-- <PlusIcon className="absolute size-4 left-[-9.4px] top-[-9.4px]" /> -->
            <!-- <PlusIcon className="absolute size-4 right-[-9.4px] top-[-9.4px]" /> -->
            <div class="flex items-center justify-between border-y px-6 py-4 hover:bg-accent/50 dark:hover:bg-accent/30 duration-150">
                <span class="text-xs text-muted-foreground font-thin">
                    PREVIEW * CDIN CODE
                </span>
            </div>

            <div id="preview" class="relative">
                <Button
                    client:visible
                    id="preview-open"
                    aria-label="View preview larger"
                    className="absolute border-white! active:scale-98 bottom-5 right-5 bg-transparent hover:bg-white! text-white hover:text-black!"
                    size={"icon-lg"}
                    variant={`outline`}
                >
                    <Maximize />
                </Button>
                <img
                    src="/CDIN-CODE.webp"
                    alt="Cdin code preview"
                    width="1980"
                    height="1080"
                    class="w-full aspect-video"
                />
            </div>
            <!-- <PlusIcon className="absolute size-4 left-[-9.4px] bottom-[-9.4px]" /> -->
            <!-- <PlusIcon className="absolute size-4 right-[-9.4px] bottom-[-9.4px]" /> -->
        </div>

        <dialog
            id="preview-dialog"
            aria-label="Cdin code preview"
            class="m-auto border-0 bg-transparent p-0 max-w-[92vw] max-h-[92vh] overflow-visible"
        >
            <div class="relative">
                <Button
                    client:visible
                    id="preview-close"
                    aria-label="Close preview"
                    variant={`secondary`}
                    size={"icon-lg"}
                    className="absolute top-6 right-6 z-10 scale-125"
                >
                    <XIcon />
                </Button>
                <img
                    src="/CDIN-CODE.webp"
                    alt="Cdin code preview"
                    class="max-w-[92vw] max-h-[92vh] w-auto h-auto object-contain rounded-lg"
                />
            </div>
        </dialog>

        <script>
            const openBtn = document.getElementById("preview-open");
            const closeBtn = document.getElementById("preview-close");
            const dialog = document.getElementById("preview-dialog");

            openBtn?.addEventListener("click", () => {
                if (dialog instanceof HTMLDialogElement) dialog.showModal();
            });
            closeBtn?.addEventListener("click", () => {
                if (dialog instanceof HTMLDialogElement) dialog.close();
            });
            dialog?.addEventListener("click", (e) => {
                if (e.target === dialog && dialog instanceof HTMLDialogElement)
                    dialog.close();
            });
        </script>
        <style>
            #preview-dialog::backdrop {
                background: rgba(0, 0, 0, 0.8);
                backdrop-filter: blur(2px);
            }
        </style>

        <div class="relative">
            <div class="flex items-center justify-between border-y px-4 sm:px-6 py-4 hover:bg-accent/50 dark:hover:bg-accent/30 duration-150 flex-wrap">
                <span
                    id="platforms"
                    class="text-xs text-muted-foreground font-thin"
                >
                    PLATFORMS
                </span>
                <span class="text-xs text-muted-foreground font-thin">
                    REQUIREMENT - ELECTRICITY (optional)
                </span>
            </div>

            <div class="grid divide-y lg:divide-x grid-cols-1 lg:grid-cols-2">
                <div class="sm:p-6 p-4 flex items-center justify-between flex-wrap gap-6">
                    <h5 class="flex items-center gap-2 text-lg sm:text-xl font-bold">
                        <img
                            src="/linux.svg"
                            alt="linux"
                            width="1980"
                            height="1080"
                            class="w-8 aspect-square dark:invert"
                        />
                        LINUX (deb)
                    </h5>
                    <Link
                        href="https://github.com/cdin-editor/cdin/releases/download/v0.2.1-beta.9/cdin_0.2.1.beta.9_amd64.deb"
                        icon={DownloadIcon}
                        label="DOWNLOAD FOR LINUX"
                        buttonClassName="m-0"
                        variant={`default`}
                    />
                </div>
                <div class="sm:p-6 p-4 flex items-center justify-between flex-wrap gap-6">
                    <h5 class="flex items-center gap-2 text-lg sm:text-xl font-bold">
                        <CodeXml />
                        SOURCE
                    </h5>
                    <Link
                        href="docs/guides/getting-started"
                        icon={SquareArrowOutUpRight}
                        label="BUILT FROM SOURCE"
                        buttonClassName="m-0"
                        variant={`default`}
                    />
                </div>
                <div class="lg:col-span-2 text-muted-foreground text-xs hover:text-primary duration-150 p-4 text-center">
                    macOS (and other linux distros) coming soon
                </div>
            </div>
            <!-- <PlusIcon className="absolute size-4 left-[-9.4px] bottom-[-9.4px]" /> -->
            <!-- <PlusIcon className="absolute size-4 right-[-9.4px] bottom-[-9.4px]" /> -->
        </div>
    </section>
</BaseLayout>
